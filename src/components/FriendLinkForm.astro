<script is:inline>
  (function () {
    var root = document.getElementById("friendlink-form-root");
    if (!root) return;

    var apiBase =
      root.dataset.apiBase ||
      window.__FRIENDLINK_API_BASE__ ||
      "https://verify.081531.xyz";
    var apiUrl = apiBase.replace(/\/$/, "") + "/api/submissions";
    var initialMode =
      root.dataset.initialMode === "update" ? "update" : "apply";
    var currentMode = initialMode;
    var formState = { apply: {}, update: {} };
    var requestId = 0;

    var cbIds = ["fl-cb1", "fl-cb2", "fl-cb3", "fl-cb4", "fl-cb5"];
