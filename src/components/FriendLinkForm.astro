---
export interface Props {
  mode?: "apply" | "update";
  apiBase?: string;
}

const { mode = "apply", apiBase } = Astro.props;
---

<div
  id="friendlink-form-root"
  class="fl-root"
  data-initial-mode={mode}
  data-api-base={apiBase}
>
  <section
    class="fl-card fl-application-card"
    aria-labelledby="fl-application-title"
  >
    <span class="fl-tape" aria-hidden="true"></span>
    <span class="fl-tab" aria-hidden="true"></span>

    <header class="fl-card-head">
      <div>
        <p class="fl-eyebrow">FRIENDLINK / NOTE 01</p>
        <h2 id="fl-application-title" class="fl-card-title">友链申请簿</h2>
        <span class="fl-card-underline" aria-hidden="true"></span>
      </div>
      <p class="fl-card-intro">
        按照 Butterfly 友链格式提交信息，审核通过后会同步到友链 YAML。
      </p>
    </header>

    <div class="fl-section-label" aria-hidden="true">
      <span>01</span>
      <span>申请前确认</span>
    </div>

    <fieldset class="fl-conditions" aria-describedby="fl-conditions-help">
      <legend>请先确认满足以下条件</legend>
      <p id="fl-conditions-help" class="fl-cond-desc">
        勾选全部条件后，申请和更新表单会自动展开。
      </p>
      <div class="fl-condition-grid">
        <label class="fl-checkbox" for="fl-cb1">
          <input type="checkbox" id="fl-cb1" />
          <span>我已添加 <strong>喵洛阁</strong> 的友情链接</span>
        </label>
        <label class="fl-checkbox" for="fl-cb2">
          <input type="checkbox" id="fl-cb2" />
          <span>我的网站现在可以在中国大陆区域正常访问</span>
        </label>
        <label class="fl-checkbox" for="fl-cb3">
          <input type="checkbox" id="fl-cb3" />
          <span>网站内容符合中国大陆法律法规</span>
        </label>
        <label class="fl-checkbox" for="fl-cb4">
          <input type="checkbox" id="fl-cb4" />
          <span
            >我的链接主体为 <strong>个人</strong>，网站类型为 <strong
              >博客</strong
            ></span
          >
        </label>
        <label class="fl-checkbox" for="fl-cb5">
          <input type="checkbox" id="fl-cb5" />
          <span>网站域名不是 us.kg 等免费域名（github.io、gitee.io 除外）</span>
        </label>
      </div>
    </fieldset>

    <p id="fl-condition-hint" class="fl-cond-hint" role="status">
      还差一些确认，完成后再继续填写。
    </p>

    <div id="fl-options" class="fl-options" hidden>
      <div class="fl-section-label" aria-hidden="true">
        <span>02</span>
        <span>填写信息</span>
      </div>

      <div class="fl-mode-tabs" role="tablist" aria-label="友链操作">
        <button
          type="button"
          id="fl-tab-apply"
          class="fl-mode-btn"
          role="tab"
          aria-controls="fl-form-container"
          data-mode="apply">申请友链</button
        >
        <button
          type="button"
          id="fl-tab-update"
          class="fl-mode-btn"
          role="tab"
          aria-controls="fl-form-container"
          data-mode="update">更新友链</button
        >
      </div>

      <div
        id="fl-form-container"
        role="tabpanel"
        tabindex="0"
        aria-labelledby="fl-tab-apply"
      >
      </div>
    </div>
  </section>

  <section class="fl-card fl-status-card" aria-labelledby="fl-status-title">
    <span class="fl-tape fl-tape--green" aria-hidden="true"></span>
    <span class="fl-tab fl-tab--green" aria-hidden="true"></span>

    <header class="fl-status-head">
      <div class="fl-card-head">
        <p class="fl-eyebrow">FRIENDLINK / LOG</p>
        <h2 id="fl-status-title" class="fl-card-title">申请进度</h2>
        <span class="fl-card-underline" aria-hidden="true"></span>
      </div>
      <p class="fl-card-intro">可以按状态或站点名称查找公开申请记录。</p>
    </header>

    <div class="fl-status-controls">
      <label class="fl-control-label" for="fl-status-filter">状态</label>
      <select id="fl-status-filter" class="fl-control-input">
        <option value="">全部状态</option>
        <option value="pending">待审核</option>
        <option value="approved">已通过</option>
        <option value="rejected">已拒绝</option>
      </select>
      <label class="fl-control-label fl-search-label" for="fl-status-search"
        >搜索</label
      >
      <div class="fl-search-wrap">
        <span class="fl-search-icon" aria-hidden="true">⌕</span>
        <input
          id="fl-status-search"
          type="search"
          placeholder="搜索站点名称"
          class="fl-control-input fl-search-input"
          autocomplete="off"
        />
      </div>
      <span class="fl-status-count" id="fl-status-count" aria-live="polite"
      ></span>
    </div>

    <div
      id="fl-status-grid"
      class="fl-status-grid"
      aria-live="polite"
      aria-busy="true"
    >
      <div class="fl-status-loading">正在翻阅申请记录…</div>
    </div>
    <nav id="fl-pagination" class="fl-pagination" aria-label="申请记录分页">
    </nav>
  </section>
</div>

<style is:global>
  .fl-root {
    --fl-card-bg: linear-gradient(
      160deg,
      var(--fp-paper) 0%,
      color-mix(in srgb, var(--fp-warm) 90%, transparent) 100%
    );
    --fl-border: color-mix(in srgb, var(--fp-dash) 58%, transparent);
    --fl-inner-bg: color-mix(in srgb, var(--fp-paper) 72%, transparent);
    --fl-input-bg: var(--fp-paper);
    --fl-input-border: var(--fp-dash);
    --fl-err-text: #dc2626;
    --fl-success-text: var(--fp-accent-strong);
    --fl-status-pending-bg: color-mix(in srgb, #facc15 18%, var(--fp-paper));
    --fl-status-pending-text: #a16207;
    --fl-status-approved-bg: color-mix(in srgb, #4ade80 18%, var(--fp-paper));
    --fl-status-approved-text: #15803d;
    --fl-status-rejected-bg: color-mix(in srgb, #f87171 18%, var(--fp-paper));
    --fl-status-rejected-text: #dc2626;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .fl-card {
    --fl-tilt: -0.12deg;
    position: relative;
    min-width: 0;
    padding: 1.6rem 1.4rem 1.45rem;
    border: 1px solid var(--fl-border);
    border-radius: 255px 15px 225px 15px / 15px 225px 15px 255px;
    background: var(--fl-card-bg);
    box-shadow:
      var(--fp-shadow),
      inset 0 1px color-mix(in srgb, var(--fp-paper) 70%, transparent);
    transform: rotate(var(--fl-tilt));
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }

  .fl-card:hover {
    transform: translateY(-1px) rotate(0deg);
    box-shadow:
      var(--fp-soft-shadow),
      inset 0 1px color-mix(in srgb, var(--fp-paper) 70%, transparent);
  }

  .fl-status-card {
    --fl-tilt: 0.15deg;
  }

  .fl-tape {
    position: absolute;
    top: -7px;
    left: 30px;
    z-index: 2;
    width: 42px;
    height: 15px;
    border-radius: 2px;
    background-color: var(--fp-tape);
    background-image: repeating-linear-gradient(
      45deg,
      rgba(255, 255, 255, 0.22) 0 2px,
      transparent 2px 6px
    );
    box-shadow: 0 2px 6px rgba(82, 64, 38, 0.1);
    pointer-events: none;
    transform: rotate(-3deg);
  }

  html.dark .fl-tape {
    background-image: repeating-linear-gradient(
      45deg,
      rgba(0, 0, 0, 0.12) 0 2px,
      transparent 2px 6px
    );
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
  }

  .fl-tape--green {
    background-color: color-mix(
      in srgb,
      var(--fp-accent-soft) 78%,
      var(--fp-paper)
    );
    transform: rotate(-2deg);
  }

  .fl-tab {
    position: absolute;
    top: 22px;
    right: -5px;
    z-index: -1;
    width: 6px;
    height: 48px;
    border: 1px dashed color-mix(in srgb, var(--fp-dash) 50%, transparent);
    border-left: 0;
    border-radius: 0 6px 6px 0;
    background: var(--fp-accent-muted);
    box-shadow: 2px 3px 0 rgba(82, 64, 38, 0.06);
    pointer-events: none;
    transition:
      width 0.25s cubic-bezier(0.34, 1.56, 0.64, 1),
      right 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  html.dark .fl-tab {
    border-color: rgba(225, 230, 245, 0.08);
    box-shadow: 3px 3px 0 rgba(0, 0, 0, 0.14);
  }

  .fl-tab--green {
    background: var(--fp-accent);
  }

  .fl-card:hover .fl-tab {
    right: -10px;
    width: 11px;
  }

  .fl-card-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .fl-eyebrow {
    margin: 0 0 0.25rem;
    color: var(--fp-accent-strong);
    font-family: "Noto Sans Mono", monospace;
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    line-height: 1.4;
  }

  .fl-card-title {
    margin: 0;
    color: var(--fp-ink);
    font-size: 1.125rem;
    font-weight: 750;
    line-height: 1.3;
  }

  .fl-card-underline {
    display: block;
    width: 2.4em;
    max-width: 48%;
    height: 5px;
    margin-top: 4px;
    background-color: var(--fp-accent);
    opacity: 0.7;
    mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 50 8'><path d='M1 4.5 C 10 2.5 16 5 24 3.6 C 32 2.2 40 5.2 47 3.4' fill='none' stroke='black' stroke-width='5'/></svg>");
    -webkit-mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 50 8'><path d='M1 4.5 C 10 2.5 16 5 24 3.6 C 32 2.2 40 5.2 47 3.4' fill='none' stroke='black' stroke-width='5'/></svg>");
    mask-repeat: no-repeat;
    -webkit-mask-repeat: no-repeat;
    mask-size: contain;
    -webkit-mask-size: contain;
  }

  .fl-card-intro {
    max-width: 19rem;
    margin: 0;
    color: var(--fp-muted);
    font-size: 0.75rem;
    line-height: 1.65;
    text-align: right;
  }

  .fl-section-label {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin: 1.25rem 0 0.7rem;
    color: var(--fp-muted);
    font-family: "Noto Sans Mono", monospace;
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
  }

  .fl-section-label::after {
    flex: 1;
    height: 1px;
    background: var(--fp-dash);
    content: "";
    opacity: 0.7;
  }

  .fl-section-label > span:first-child {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.55rem;
    height: 1.35rem;
    border: 1px solid var(--fp-accent-muted);
    color: var(--fp-accent-strong);
    font-size: 0.625rem;
  }

  .fl-conditions {
    min-width: 0;
    margin: 0;
    padding: 0.9rem 1rem 0.85rem;
    border: 1px dashed color-mix(in srgb, var(--fp-dash) 80%, transparent);
    border-radius: 8px 255px 8px 225px / 225px 8px 225px 8px;
    background: color-mix(in srgb, var(--fp-warm) 50%, transparent);
  }

  .fl-conditions legend {
    padding: 0 0.35rem;
    color: var(--fp-ink);
    font-size: 0.8125rem;
    font-weight: 700;
  }

  .fl-cond-desc {
    margin: 0 0 0.65rem;
    color: var(--fp-ink-soft);
    font-size: 0.75rem;
    line-height: 1.6;
  }

  .fl-condition-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.15rem 1rem;
  }

  .fl-checkbox {
    display: flex;
    align-items: flex-start;
    min-width: 0;
    gap: 0.5rem;
    padding: 0.3rem 0;
    color: var(--fp-ink);
    cursor: pointer;
    font-size: 0.75rem;
    line-height: 1.55;
  }

  .fl-checkbox input {
    width: 1rem;
    height: 1rem;
    flex: 0 0 auto;
    margin: 0.1rem 0 0;
    accent-color: var(--fp-accent);
    cursor: pointer;
  }

  .fl-checkbox strong {
    color: var(--fp-accent-strong);
    font-weight: 700;
  }

  .fl-cond-hint {
    margin: 0.6rem 0 0;
    color: var(--fp-muted);
    font-size: 0.6875rem;
    line-height: 1.5;
  }

  .fl-options[hidden] {
    display: none;
  }

  .fl-mode-tabs {
    display: flex;
    gap: 0.25rem;
    margin-bottom: 1rem;
    padding: 0.25rem;
    border: 1px solid color-mix(in srgb, var(--fp-dash) 55%, transparent);
    border-radius: 255px 8px 225px 8px / 8px 225px 8px 255px;
    background: var(--fl-inner-bg);
  }

  .fl-mode-btn,
  .fl-secondary-btn,
  .fl-page-btn {
    border: 1px solid transparent;
    font-family: inherit;
    cursor: pointer;
  }

  .fl-mode-btn {
    flex: 1;
    min-height: 2.25rem;
    padding: 0.5rem 0.75rem;
    border-radius: 255px 6px 225px 6px / 6px 225px 6px 255px;
    background: transparent;
    color: var(--fp-ink-soft);
    font-size: 0.75rem;
    font-weight: 650;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .fl-mode-btn:hover {
    background: color-mix(in srgb, var(--fp-warm) 80%, transparent);
    color: var(--fp-ink);
  }

  .fl-mode-btn.active {
    background: var(--fp-accent);
    color: var(--fp-paper);
    box-shadow: 0 1px 3px color-mix(in srgb, var(--fp-ink) 12%, transparent);
  }

  .fl-form-inner {
    animation: fl-fade-in 0.3s ease;
  }

  @keyframes fl-fade-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .fl-form-heading {
    margin: 0 0 0.2rem;
    color: var(--fp-ink);
    font-size: 0.9375rem;
    font-weight: 700;
  }

  .fl-form-subtitle {
    margin: 0 0 1rem;
    color: var(--fp-muted);
    font-size: 0.6875rem;
    line-height: 1.6;
  }

  .fl-form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 0.85rem;
  }

  .fl-field {
    min-width: 0;
    margin-bottom: 0.8rem;
  }

  .fl-label {
    display: block;
    margin-bottom: 0.3rem;
    color: var(--fp-ink);
    font-size: 0.75rem;
    font-weight: 650;
  }

  .fl-star {
    color: var(--fl-err-text);
  }

  .fl-input {
    box-sizing: border-box;
    width: 100%;
    min-height: 2.35rem;
    padding: 0.5rem 0.7rem;
    border: 1px solid var(--fl-input-border);
    border-radius: 255px 6px 225px 6px / 6px 225px 6px 255px;
    outline: none;
    background: var(--fl-input-bg);
    box-shadow: inset 0 1px color-mix(in srgb, var(--fp-paper) 60%, transparent);
    color: var(--fp-ink);
    font-family: inherit;
    font-size: 0.75rem;
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease;
  }

  .fl-input::placeholder,
  .fl-control-input::placeholder {
    color: var(--fp-muted);
    opacity: 0.9;
  }

  .fl-input:focus,
  .fl-control-input:focus,
  .fl-mode-btn:focus-visible,
  .fl-secondary-btn:focus-visible,
  .fl-page-btn:focus-visible,
  .fl-checkbox input:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--fp-accent) 65%, transparent);
    outline-offset: 2px;
  }

  .fl-input:focus,
  .fl-control-input:focus {
    border-color: var(--fp-accent);
    box-shadow:
      inset 0 1px color-mix(in srgb, var(--fp-paper) 60%, transparent),
      0 0 0 2px color-mix(in srgb, var(--fp-accent) 15%, transparent);
  }

  .fl-input[aria-invalid="true"] {
    border-color: var(--fl-err-text);
  }

  .fl-field-error {
    min-height: 0;
    margin: 0.25rem 0 0;
    color: var(--fl-err-text);
    font-size: 0.6875rem;
    line-height: 1.45;
  }

  .fl-hint {
    margin: 0.25rem 0 0;
    color: var(--fp-muted);
    font-size: 0.625rem;
    line-height: 1.45;
  }

  .fl-err-box {
    display: none;
    margin-bottom: 0.85rem;
    padding: 0.6rem 0.75rem;
    border: 1px solid color-mix(in srgb, #dc2626 25%, var(--fp-dash));
    border-radius: 255px 6px 225px 6px / 6px 225px 6px 255px;
    background: color-mix(in srgb, #dc2626 8%, var(--fp-paper));
    color: var(--fl-err-text);
    font-size: 0.75rem;
    line-height: 1.5;
  }

  .fl-err-box.visible {
    display: block;
  }

  .fl-btn {
    width: 100%;
    min-height: 2.45rem;
    margin-top: 0.25rem;
    padding: 0.55rem 1rem;
    border: 0;
    border-radius: 255px 8px 225px 8px / 8px 225px 8px 255px;
    background: var(--fp-accent);
    color: var(--fp-paper);
    cursor: pointer;
    font-family: inherit;
    font-size: 0.8125rem;
    font-weight: 700;
    transition:
      background-color 0.15s ease,
      transform 0.15s ease;
  }

  .fl-btn:hover:not(:disabled) {
    background: var(--fp-accent-strong);
    transform: translateY(-1px);
  }

  .fl-btn:disabled {
    background: var(--fp-muted);
    cursor: wait;
  }

  .fl-success {
    padding: 1.6rem 1rem 1rem;
    text-align: center;
    animation: fl-fade-in 0.3s ease;
  }

  .fl-success[hidden] {
    display: none;
  }

  .fl-success-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.65rem;
    height: 2.65rem;
    margin: 0 auto 0.75rem;
    border: 1px solid var(--fp-accent-muted);
    border-radius: 50%;
    background: color-mix(in srgb, var(--fp-accent) 12%, var(--fp-paper));
  }

  .fl-success-icon svg {
    width: 1.3rem;
    height: 1.3rem;
    fill: none;
    stroke: var(--fl-success-text);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
  }

  .fl-success h3 {
    margin: 0 0 0.25rem;
    color: var(--fp-ink);
    font-size: 0.9375rem;
  }

  .fl-success p {
    margin: 0;
    color: var(--fp-ink-soft);
    font-size: 0.75rem;
    line-height: 1.6;
  }

  .fl-success-actions {
    display: flex;
    justify-content: center;
    margin-top: 0.85rem;
  }

  .fl-secondary-btn {
    padding: 0.4rem 0.8rem;
    border-color: var(--fp-dash);
    border-radius: 255px 6px 225px 6px / 6px 225px 6px 255px;
    background: transparent;
    color: var(--fp-accent-strong);
    font-size: 0.6875rem;
  }

  .fl-secondary-btn:hover {
    border-color: var(--fp-accent);
    background: color-mix(in srgb, var(--fp-accent) 8%, transparent);
  }

  .fl-status-head {
    margin-bottom: 0.85rem;
  }

  .fl-status-controls {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-bottom: 0.95rem;
    padding: 0.55rem 0.65rem;
    border-top: 1px dashed var(--fp-dash);
    border-bottom: 1px dashed var(--fp-dash);
  }

  .fl-control-label {
    color: var(--fp-muted);
    font-size: 0.625rem;
    font-weight: 650;
  }

  .fl-search-label {
    margin-left: 0.35rem;
  }

  .fl-control-input {
    min-height: 1.9rem;
    padding: 0.35rem 0.55rem;
    border: 1px solid var(--fl-input-border);
    border-radius: 255px 5px 225px 5px / 5px 225px 5px 255px;
    outline: none;
    background: var(--fl-input-bg);
    color: var(--fp-ink-soft);
    font-family: inherit;
    font-size: 0.6875rem;
  }

  .fl-search-wrap {
    position: relative;
    min-width: 8rem;
    flex: 1 1 9rem;
  }

  .fl-search-icon {
    position: absolute;
    top: 50%;
    left: 0.6rem;
    color: var(--fp-muted);
    font-size: 0.9rem;
    line-height: 1;
    pointer-events: none;
    transform: translateY(-52%);
  }

  .fl-search-input {
    box-sizing: border-box;
    width: 100%;
    padding-left: 1.55rem;
  }

  .fl-status-count {
    margin-left: auto;
    color: var(--fp-muted);
    font-family: "Noto Sans Mono", monospace;
    font-size: 0.625rem;
    white-space: nowrap;
  }

  .fl-status-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.65rem;
  }

  .fl-status-loading,
  .fl-status-empty,
  .fl-status-error {
    grid-column: 1 / -1;
    padding: 2rem 1rem;
    color: var(--fp-muted);
    font-size: 0.75rem;
    text-align: center;
  }

  .fl-status-error {
    color: var(--fl-err-text);
  }

