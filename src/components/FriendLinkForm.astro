          placeholder: "https://example.com/atom.xml",
        },
        {
          key: "email",
          label: "邮箱",
          required: false,
          type: "email",
          placeholder: "用于接收审核结果通知（选填）",
          hint: "只用于接收审核结果通知。",
          autocomplete: "email",
        },
      ],
    };

    function escapeHtml(value) {
      var div = document.createElement("div");
      div.textContent = value == null ? "" : String(value);
      return div.innerHTML;
    }

    function escapeAttribute(value) {
      var entities = {
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;",
        "`": "&#96;",
      };
      return String(value == null ? "" : value).replace(
        /[&<>"'`]/g,
        function (character) {
          return entities[character];
        },
      );
    }

    function fieldId(mode, key) {
      return "fl-" + mode + "-" + key;
    }

    function setActiveTab(mode) {
      currentMode = mode === "update" ? "update" : "apply";
      var isApply = currentMode === "apply";
      tabApply.classList.toggle("active", isApply);
      tabUpdate.classList.toggle("active", !isApply);
      tabApply.setAttribute("aria-selected", String(isApply));
      tabUpdate.setAttribute("aria-selected", String(!isApply));
      formContainer.setAttribute(
        "aria-labelledby",
        isApply ? "fl-tab-apply" : "fl-tab-update",
      );
      tabApply.tabIndex = isApply ? 0 : -1;
      tabUpdate.tabIndex = isApply ? -1 : 0;
      renderForm(currentMode);
    }

    function updateConditionGate() {
      var allChecked = cbIds.every(function (id) {
        var checkbox = root.querySelector("#" + id);
        return checkbox && checkbox.checked;
      });
      optionsEl.hidden = !allChecked;
      conditionHint.hidden = allChecked;
    }

    function fieldMarkup(mode, field) {
      var id = fieldId(mode, field.key);
      var state = formState[mode][field.key] || "";
      var hintId = field.hint ? id + "-hint" : "";
      var errorId = id + "-error";
      var describedBy =
        ' aria-describedby="' +
        [hintId, errorId].filter(Boolean).join(" ") +
        '"';
      return (
        '<div class="fl-field">' +
        '<label class="fl-label" for="' +
        id +
        '">' +
        escapeHtml(field.label) +
        (field.required
          ? ' <span class="fl-star" aria-hidden="true">*</span>'
          : "") +
        "</label>" +
        '<input class="fl-input" id="' +
        id +
        '" name="' +
        escapeAttribute(field.key) +
        '" type="' +
        field.type +
        '" placeholder="' +
        escapeAttribute(field.placeholder) +
        '" value="' +
        escapeAttribute(state) +
        '"' +
        (field.required ? " required" : "") +
        (field.autocomplete
          ? ' autocomplete="' + field.autocomplete + '"'
          : "") +
        describedBy +
        ' aria-invalid="false" />' +
        (field.hint
          ? '<p class="fl-hint" id="' +
            hintId +
            '">' +
            escapeHtml(field.hint) +
            "</p>"
          : "") +
        '<p class="fl-field-error" id="' +
        errorId +
        '" aria-live="polite"></p>' +
        "</div>"
      );
    }

    function renderForm(mode) {
      var fields = fieldsByMode[mode];
      var title = mode === "apply" ? "申请友链" : "更新友链";
      var subtitle =
        mode === "apply"
          ? "填写这些信息，审核通过后会按 Butterfly YAML 格式发布。"
          : "用原站点地址找到已有记录，再填写需要更新的信息。";
      var html =
        '<form class="fl-form-inner" id="fl-form-' +
        mode +
        '" novalidate>' +
        '<h3 class="fl-form-heading">' +
        title +
        '</h3><p class="fl-form-subtitle">' +
        subtitle +
        '</p><div class="fl-err-box" id="fl-error-' +
        mode +
        '" role="alert"></div>' +
        '<div class="fl-form-grid">';

      fields.forEach(function (field) {
        html += fieldMarkup(mode, field);
      });

      html +=
        '</div><button type="submit" class="fl-btn" id="fl-submit-' +
        mode +
        '">' +
        (mode === "apply" ? "提交申请" : "提交更新") +
        "</button></form>" +
        '<div class="fl-success" id="fl-success-' +
        mode +
        '" role="status" tabindex="-1" hidden>' +
        '<div class="fl-success-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg></div>' +
        "<h3>提交成功</h3><p>感谢你！友链" +
        (mode === "apply" ? "申请" : "更新请求") +
        "已经提交，等待管理员审核。</p>" +
        (mode === "apply"
          ? "<p>如果填写了邮箱，审核结果会通过邮件通知你。</p>"
          : "") +
        '<div class="fl-success-actions"><button type="button" class="fl-secondary-btn" data-action="again">继续填写</button></div></div>';

      formContainer.innerHTML = html;
      attachForm(mode);
    }

    function setFieldError(input, message) {
      var error = root.querySelector("#" + input.id + "-error");
      input.setAttribute("aria-invalid", message ? "true" : "false");
      if (error) error.textContent = message || "";
    }

    function validateField(mode, field) {
      var input = root.querySelector("#" + fieldId(mode, field.key));
      if (!input) return false;
      var value = input.value.trim();
      var message = "";

      if (field.required && !value) {
        message = "请填写" + field.label + "。";
      } else if (value && input.type === "url" && !input.checkValidity()) {
        message = "请输入有效的网址（需包含 http:// 或 https://）。";
      } else if (value && input.type === "email" && !input.checkValidity()) {
        message = "请输入有效的邮箱地址。";
      }

      setFieldError(input, message);
      return !message;
    }

    function attachForm(mode) {
      var form = root.querySelector("#fl-form-" + mode);
      if (!form) return;
      var fields = fieldsByMode[mode];

      fields.forEach(function (field) {
        var input = root.querySelector("#" + fieldId(mode, field.key));
        if (!input) return;
        input.addEventListener("input", function () {
          formState[mode][field.key] = input.value;
          if (input.getAttribute("aria-invalid") === "true") {
            validateField(mode, field);
          }
        });
        input.addEventListener("blur", function () {
          if (input.value.trim()) validateField(mode, field);
        });
      });

      form.addEventListener("submit", function (event) {
        event.preventDefault();
        handleSubmit(mode);
      });

      var againButton = root.querySelector(
        "#fl-success-" + mode + ' [data-action="again"]',
      );
      if (againButton) {
        againButton.addEventListener("click", function () {
          var success = root.querySelector("#fl-success-" + mode);
          var errorBox = root.querySelector("#fl-error-" + mode);
          form.hidden = false;
          success.hidden = true;
          if (errorBox) {
            errorBox.textContent = "";
            errorBox.classList.remove("visible");
          }
          fieldsByMode[mode].forEach(function (field) {
            var input = root.querySelector("#" + fieldId(mode, field.key));
            if (input) input.setAttribute("aria-invalid", "false");
          });
          var firstInput = form.querySelector(".fl-input");
          if (firstInput) firstInput.focus();
        });
      }
    }

    function handleSubmit(mode) {
      var fields = fieldsByMode[mode];
      var form = root.querySelector("#fl-form-" + mode);
      var submitButton = root.querySelector("#fl-submit-" + mode);
      var errorBox = root.querySelector("#fl-error-" + mode);
      var firstInvalid = null;
      var valid = true;

      fields.forEach(function (field) {
        if (!validateField(mode, field)) {
          valid = false;
          if (!firstInvalid)
            firstInvalid = root.querySelector("#" + fieldId(mode, field.key));
        }
      });

      if (!valid) {
        errorBox.textContent = "请先修正标记出来的字段。";
        errorBox.classList.add("visible");
        if (firstInvalid) firstInvalid.focus();
        return;
      }

      errorBox.classList.remove("visible");
      var payload = { type: mode };
      fields.forEach(function (field) {
        var input = root.querySelector("#" + fieldId(mode, field.key));
        var value = input ? input.value.trim() : "";
        if (value) payload[field.key] = value;
      });

      submitButton.disabled = true;
      submitButton.textContent = "提交中…";
      form.setAttribute("aria-busy", "true");

      fetch(apiUrl, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      })
        .then(function (response) {
          return response.text().then(function (text) {
            var data = {};
            try {
              data = text ? JSON.parse(text) : {};
            } catch (error) {
              data = {};
            }
            if (!response.ok) {
              throw new Error(data.error || "提交失败，请稍后重试。");
            }
            return data;
          });
        })
        .then(function () {
          form.hidden = true;
          var success = root.querySelector("#fl-success-" + mode);
          success.hidden = false;
          success.focus();
          var statusGrid = root.querySelector("#fl-status-grid");
          if (statusGrid) renderStatus();
        })
        .catch(function (error) {
          errorBox.textContent = error.message || "网络异常，请稍后重试。";
          errorBox.classList.add("visible");
        })
        .finally(function () {
          submitButton.disabled = false;
          submitButton.textContent = mode === "apply" ? "提交申请" : "提交更新";
          form.setAttribute("aria-busy", "false");
        });
    }

    cbIds.forEach(function (id) {
      var checkbox = root.querySelector("#" + id);
      if (checkbox) checkbox.addEventListener("change", updateConditionGate);
    });

    tabApply.addEventListener("click", function () {
      setActiveTab("apply");
    });
    tabUpdate.addEventListener("click", function () {
      setActiveTab("update");
    });
    [tabApply, tabUpdate].forEach(function (tab) {
      tab.addEventListener("keydown", function (event) {
        if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
        event.preventDefault();
        setActiveTab(event.key === "ArrowLeft" ? "apply" : "update");
        (event.key === "ArrowLeft" ? tabApply : tabUpdate).focus();
      });
    });

    setActiveTab(initialMode);
    updateConditionGate();

    var gridEl = root.querySelector("#fl-status-grid");
    var countEl = root.querySelector("#fl-status-count");
    var paginationEl = root.querySelector("#fl-pagination");
    var filterEl = root.querySelector("#fl-status-filter");
    var searchEl = root.querySelector("#fl-status-search");
    var currentStatus = "";
    var currentPage = 1;
    var pageSize = 9;
    var searchTimer = null;

    function statusText(status) {
      if (status === "pending") return "待审核";
      if (status === "approved") return "已通过";
      if (status === "rejected") return "已拒绝";
      return "未知状态";
    }

    function typeText(type) {
      if (type === "update") return "更新";
      if (type === "apply") return "新增";
      return "未知类型";
    }

    function statusClass(status) {
      return ["pending", "approved", "rejected"].indexOf(status) >= 0
        ? status
        : "pending";
    }

    function renderPagination(totalPages) {
      if (totalPages <= 1) {
        paginationEl.innerHTML = "";
        return;
      }

      var pages = [];
      if (totalPages <= 7) {
        for (var i = 1; i <= totalPages; i++) pages.push(i);
      } else {
        pages.push(1);
        if (currentPage > 3) pages.push("...");
        for (
          var page = Math.max(2, currentPage - 1);
          page <= Math.min(totalPages - 1, currentPage + 1);
          page++
        ) {
          pages.push(page);
        }
        if (currentPage < totalPages - 2) pages.push("...");
        pages.push(totalPages);
      }

      var html =
        '<button type="button" class="fl-page-btn" data-page="' +
        (currentPage - 1) +
        '"' +
        (currentPage === 1 ? " disabled" : "") +
        ' aria-label="上一页">‹</button>';
      pages.forEach(function (page) {
        if (page === "...") {
          html += '<span class="fl-page-dots" aria-hidden="true">…</span>';
        } else {
          html +=
            '<button type="button" class="fl-page-btn' +
            (page === currentPage ? " active" : "") +
            '" data-page="' +
            page +
            '" aria-label="第 ' +
            page +
            ' 页"' +
            (page === currentPage ? ' aria-current="page"' : "") +
            ">" +
            page +
            "</button>";
        }
      });
      html +=
        '<button type="button" class="fl-page-btn" data-page="' +
        (currentPage + 1) +
        '"' +
        (currentPage === totalPages ? " disabled" : "") +
        ' aria-label="下一页">›</button>';
      paginationEl.innerHTML = html;
    }

    function renderStatus() {
      var thisRequest = ++requestId;
      var keyword = searchEl.value.trim();
      var params = new URLSearchParams({ public: "1" });
      if (currentStatus) params.set("status", currentStatus);
      if (keyword) params.set("search", keyword);
      gridEl.setAttribute("aria-busy", "true");
      gridEl.innerHTML =
        '<div class="fl-status-loading">正在翻阅申请记录…</div>';
      countEl.textContent = "";
      paginationEl.innerHTML = "";

      fetch(apiUrl + "?" + params.toString())
        .then(function (response) {
          if (!response.ok) throw new Error("申请记录暂时无法读取。");
          return response.json();
        })
        .then(function (data) {
          if (thisRequest !== requestId) return;
          var list = Array.isArray(data.submissions) ? data.submissions : [];
          var totalPages = Math.max(1, Math.ceil(list.length / pageSize));
          currentPage = Math.min(currentPage, totalPages);
          var start = (currentPage - 1) * pageSize;
          var pageItems = list.slice(start, start + pageSize);
          countEl.textContent = "共 " + list.length + " 条";

          if (!pageItems.length) {
            gridEl.innerHTML =
              '<div class="fl-status-empty">暂时没有符合条件的记录。</div>';
            return;
          }

          var html = "";
          pageItems.forEach(function (item) {
            var safeStatus = statusClass(item.status);
            var name = item.name || "未命名站点";
            var description = item.description || "暂无描述";
            html +=
              '<article class="fl-status-item">' +
              '<div class="fl-status-top"><strong class="fl-status-name" title="' +
              escapeAttribute(name) +
              '">' +
              escapeHtml(name) +
              '</strong><div class="fl-status-top-right"><span class="fl-status-badge ' +
              safeStatus +
              '">' +
              statusText(item.status) +
              '</span><span class="fl-status-type">' +
              typeText(item.type) +
              '</span></div></div><p class="fl-status-desc" title="' +
              escapeAttribute(description) +
              '">' +
              escapeHtml(description) +
              "</p></article>";
          });
          gridEl.innerHTML = html;
          renderPagination(totalPages);
        })
        .catch(function (error) {
          if (thisRequest !== requestId) return;
          gridEl.innerHTML =
            '<div class="fl-status-error" role="alert">' +
            escapeHtml(error.message || "申请记录加载失败。") +
            ' <button type="button" class="fl-status-retry" id="fl-status-retry">重试</button></div>';
          var retry = root.querySelector("#fl-status-retry");
          if (retry) retry.addEventListener("click", renderStatus);
        })
        .finally(function () {
          if (thisRequest === requestId)
            gridEl.setAttribute("aria-busy", "false");
        });
    }

    filterEl.addEventListener("change", function () {
      currentStatus = filterEl.value;
      currentPage = 1;
      renderStatus();
    });

    searchEl.addEventListener("input", function () {
      clearTimeout(searchTimer);
      searchTimer = setTimeout(function () {
        currentPage = 1;
        renderStatus();
      }, 250);
    });

    paginationEl.addEventListener("click", function (event) {
      var button = event.target.closest("[data-page]");
      if (!button || button.disabled) return;
      currentPage = Number(button.dataset.page) || 1;
      renderStatus();
    });

    renderStatus();
  })();
</script>
