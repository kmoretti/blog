---
import Layout from "../../layouts/Layout.astro";

const pageTitle = "友链详情 | 喵洛阁";
const pageDescription = "友情链接详细页面";
---

<Layout
  title={pageTitle}
  description={pageDescription}
  className="max-w-[1100px] px-4 py-6"
>
  <main class="friends-detail space-y-8">
    <header class="space-y-4">
      <div class="flex items-start justify-between gap-4">
        <div class="space-y-2">
          <nav aria-label="Breadcrumb" class="fp-breadcrumb">
            <a href="/">喵洛阁</a>
            <span class="mx-1">/</span>
            <a href="/friends/">朋友们</a>
            <span class="mx-1">/</span>
          </nav>
          <h1 class="fp-heading text-2xl font-semibold">友链详情</h1>
          <p class="fp-subtext max-w-2xl text-sm leading-6">
            欢迎大家来加入友链~
          </p>
          <p class="friend-data-note" role="note">
            友链数据使用 CDN 加速，更新可能需要一些时间。
          </p>
        </div>
        <div class="flex shrink-0 gap-2">
          <a
            href="/friends/fcircle/"
            class="fp-link-btn inline-flex items-center rounded-full px-3 py-1.5 text-sm transition"
          >
            朋友圈
          </a>
          <a
            href="/friends/"
            class="fp-link-btn inline-flex items-center rounded-full px-3 py-1.5 text-sm transition"
          >
            简洁视图
          </a>
        </div>
      </div>
      <div class="fp-muted flex flex-wrap gap-2 text-xs">
        <span id="friends-total" class="fp-tag rounded-full px-3 py-1">
          正在加载友链…
        </span>
        <span id="friends-group-total" class="fp-tag rounded-full px-3 py-1">
          正在加载分组…
        </span>
        <span class="fp-tag rounded-full px-3 py-1">
          延迟数据源：fc.081531.xyz
        </span>
      </div>
    </header>

    <div id="friend-groups" class="friend-groups" aria-live="polite">
      <p class="friend-groups__status">正在加载友链…</p>
    </div>

    <section
      id="failed-friends"
      class="failed-friends"
      aria-labelledby="failed-friends-title"
      hidden
    >
      <header class="failed-friends__header">
        <h2 id="failed-friends-title">友链墓碑</h2>
        <p>
          此处保留因长期无法访问、站点关闭或友链失效而暂时下线的朋友。
          若站点已恢复，请前往
          <a href="/friends/exchange/">友链申请表单</a>
          更新资料。
        </p>
      </header>
      <ul
        id="failed-friends-list"
        class="failed-friends__list"
        aria-label="失效友链列表"
      >
      </ul>
    </section>

    <section
      class="friend-application"
      aria-labelledby="friend-application-title"
    >
      <div>
        <h2 id="friend-application-title">申请友链</h2>
        <p>想交换友链，或需要更新已经恢复的站点资料？</p>
      </div>
      <a href="/friends/exchange/" class="friend-application__link">
        前往申请表单 <span aria-hidden="true">→</span>
      </a>
    </section>
  </main>

  <style is:inline>
    .fp-breadcrumb {
      color: var(--fp-muted);
      font-size: 0.8125rem;
    }
    .fp-breadcrumb a {
      color: inherit;
      text-decoration: none;
    }
    .fp-breadcrumb a:hover {
      text-decoration: underline;
    }
    .fp-breadcrumb strong {
      color: var(--fp-ink);
      font-weight: 600;
    }
    .fp-heading {
      color: var(--fp-ink);
    }
    .fp-subtext {
      color: var(--fp-ink-soft);
    }
    .friend-data-note {
      display: inline-flex;
      align-items: center;
      width: fit-content;
      margin: 0;
      border-left: 3px solid var(--fp-accent-muted);
      padding: 0.35rem 0.65rem;
      background: color-mix(in srgb, var(--fp-accent) 12%, transparent);
      color: var(--fp-muted);
      font-size: 0.75rem;
      line-height: 1.5;
    }
    .fp-muted {
      color: var(--fp-muted);
    }
    .fp-link-btn {
      border: 1px solid var(--fp-dash);
      background: var(--fp-paper);
      color: var(--fp-ink-soft);
    }
    .fp-link-btn:hover {
      border-color: var(--fp-accent);
      color: var(--fp-ink);
    }
    .fp-divider {
      border-color: var(--fp-dash);
    }
    .fp-divider-text {
      color: var(--fp-dash);
    }
    .fp-tag {
      border: 1px solid var(--fp-dash);
    }

    .friends-detail {
      --friends-tape-0: #f5d742;
      --friends-tape-1: #f09bc0;
      --friends-tape-2: #86d993;
      --friends-tape-3: #87b9e8;
      --friends-tab-0: #7cb87c;
      --friends-tab-1: #6ba8d6;
      --friends-tab-2: #f5d742;
      --friends-tab-3: #e8a0b8;
      --friends-card-bg: rgba(255, 255, 255, 0.92);
      --friends-card-border: rgba(24, 24, 27, 0.1);
      --friends-card-shadow:
        4px 5px 0 rgba(82, 64, 38, 0.08), 0 2px 8px rgba(15, 23, 42, 0.06);
      --friends-avatar-border: rgba(82, 64, 38, 0.12);
      --friends-avatar-shadow: 2px 3px 0 rgba(82, 64, 38, 0.08);
      --friends-shot-fallback: linear-gradient(
        135deg,
        rgba(245, 215, 66, 0.3),
        rgba(255, 255, 255, 0.92)
      );
      --friends-shot-mask: linear-gradient(
        to top,
        rgba(255, 255, 255, 0.98),
        rgba(255, 255, 255, 0.15) 45%,
        rgba(255, 255, 255, 0.02)
      );
      --friends-tag-bg: rgba(24, 24, 27, 0.04);
      --friends-meta-bg: rgba(24, 24, 27, 0.03);
      --friends-muted: #71717a;
      --friends-ink: #18181b;
      --friends-accent: #2563eb;
    }

    html.dark .friends-detail {
      --friends-tape-0: #a8862a;
      --friends-tape-1: #9e5f7a;
      --friends-tape-2: #4f7a55;
      --friends-tape-3: #4f6f8a;
      --friends-tab-0: #4a7a4a;
      --friends-tab-1: #3d6a8a;
      --friends-tab-2: #a8862a;
      --friends-tab-3: #8a5f70;
      --friends-card-bg: rgba(24, 24, 27, 0.88);
      --friends-card-border: rgba(255, 255, 255, 0.06);
      --friends-card-shadow:
        4px 5px 0 rgba(0, 0, 0, 0.2), 0 2px 8px rgba(0, 0, 0, 0.12);
      --friends-avatar-border: rgba(225, 230, 245, 0.12);
      --friends-avatar-shadow: 2px 3px 0 rgba(0, 0, 0, 0.18);
      --friends-shot-fallback: linear-gradient(
        135deg,
        rgba(168, 134, 42, 0.2),
        rgba(24, 24, 27, 0.9)
      );
      --friends-shot-mask: linear-gradient(
        to top,
        rgba(24, 24, 27, 0.98),
        rgba(24, 24, 27, 0.2) 45%,
        rgba(24, 24, 27, 0.04)
      );
      --friends-tag-bg: rgba(255, 255, 255, 0.06);
      --friends-meta-bg: rgba(255, 255, 255, 0.04);
      --friends-muted: #a1a1aa;
      --friends-ink: #e4e4e7;
      --friends-accent: #93c5fd;
    }

    .friend-groups {
      display: flex;
      flex-direction: column;
      gap: 3.25rem;
    }

    .friend-groups__status {
      margin: 0;
      color: var(--friends-muted);
      font-size: 0.875rem;
      text-align: center;
    }

    .failed-friends {
      border: 1px dashed var(--fp-dash);
      padding: 1.25rem;
      background: color-mix(in srgb, var(--fp-warm) 68%, transparent);
    }

    .failed-friends__header {
      margin-bottom: 1rem;
    }

    .failed-friends__header h2,
    .friend-application h2 {
      margin: 0;
      color: var(--friends-ink);
      font-size: 1.125rem;
      font-weight: 800;
      line-height: 1.4;
    }

    .failed-friends__header h2::first-letter {
      color: var(--friends-accent);
    }

    .failed-friends__header p,
    .friend-application p {
      margin: 0.4rem 0 0;
      color: var(--friends-muted);
      font-size: 0.8125rem;
      line-height: 1.7;
    }

    .failed-friends__header a {
      color: var(--fp-accent-strong);
      text-decoration: underline;
      text-decoration-style: wavy;
      text-decoration-color: color-mix(
        in srgb,
        var(--fp-accent) 45%,
        transparent
      );
      text-underline-offset: 3px;
    }

    .failed-friends__header a:hover {
      color: var(--fp-accent);
    }

    .failed-friends__list {
      display: flex;
      flex-wrap: wrap;
      gap: 0.65rem 1rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .failed-friends__item {
      display: inline-flex;
      align-items: center;
      min-width: 0;
      gap: 0.4rem;
      color: var(--friends-muted);
      font-size: 0.875rem;
      line-height: 1.35;
    }

    .failed-friends__avatar {
      width: 1.5rem;
      height: 1.5rem;
      flex: 0 0 auto;
      border: 1px solid var(--friends-avatar-border);
      border-radius: 50%;
      background: var(--friends-card-bg);
      object-fit: cover;
    }

    .failed-friends__name {
      border-bottom: 1px dashed currentColor;
      overflow-wrap: anywhere;
    }

    .friend-application {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      border-top: 1px dashed var(--fp-dash);
      padding-top: 1.5rem;
    }

    .friend-application__link {
      flex: 0 0 auto;
      color: var(--fp-accent-strong);
      font-size: 0.875rem;
      font-weight: 700;
      text-decoration: underline;
      text-decoration-style: wavy;
      text-decoration-color: color-mix(
        in srgb,
        var(--fp-accent) 45%,
        transparent
      );
      text-underline-offset: 3px;
    }

    .friend-application__link:hover {
      color: var(--fp-accent);
    }

    .friend-group {
      --friends-group-color: var(--friends-tape-0);
      --friends-group-tilt: -2deg;
    }

    .friend-group--1 {
      --friends-group-color: var(--friends-tape-1);
      --friends-group-tilt: 2deg;
    }

    .friend-group--2 {
      --friends-group-color: var(--friends-tape-2);
      --friends-group-tilt: -1.5deg;
    }

    .friend-group--3 {
      --friends-group-color: var(--friends-tape-3);
      --friends-group-tilt: 1.5deg;
    }

    .friend-group__header {
      position: relative;
      display: flex;
      align-items: flex-start;
      gap: 1rem;
      margin-bottom: 1.25rem;
      padding: 0 0 1rem;
      border-bottom: 1px dashed var(--friends-card-border);
    }

    .friend-group__header::after {
      content: "";
      position: absolute;
      bottom: -3px;
      left: 0;
      width: 5.5rem;
      height: 5px;
      background: var(--friends-group-color);
      opacity: 0.78;
      transform: rotate(var(--friends-group-tilt));
      mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 80 8'><path d='M1 4.5 C 14 2 23 5.5 37 3.5 C 51 1.5 63 5.5 79 3' fill='none' stroke='black' stroke-width='5'/></svg>");
      -webkit-mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 80 8'><path d='M1 4.5 C 14 2 23 5.5 37 3.5 C 51 1.5 63 5.5 79 3' fill='none' stroke='black' stroke-width='5'/></svg>");
      mask-repeat: no-repeat;
      -webkit-mask-repeat: no-repeat;
      mask-size: 100% 100%;
      -webkit-mask-size: 100% 100%;
    }

    .friend-group__tab {
      display: inline-flex;
      flex: 0 0 auto;
      align-items: center;
      gap: 0.45rem;
      min-height: 2rem;
      padding: 0.35rem 0.75rem 0.35rem 0.6rem;
      border: 1px solid
        color-mix(
          in srgb,
          var(--friends-group-color) 68%,
          var(--friends-card-border)
        );
      border-radius: 3px 10px 4px 9px;
      background: color-mix(
        in srgb,
        var(--friends-group-color) 72%,
        var(--friends-card-bg)
      );
      box-shadow: 2px 3px 0 rgba(82, 64, 38, 0.09);
      color: var(--friends-ink);
      font-family: "Noto Sans Mono", monospace;
      font-size: 0.58rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      line-height: 1;
      transform: rotate(var(--friends-group-tilt));
    }

    html.dark .friend-group__tab {
      box-shadow: 2px 3px 0 rgba(0, 0, 0, 0.2);
    }

    .friend-group__tab-mark {
      width: 0.45rem;
      height: 0.45rem;
      border-radius: 50%;
      background: currentColor;
      opacity: 0.7;
    }

    .friend-group__heading {
      min-width: 0;
      flex: 1;
    }

    .friend-group__eyebrow {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.5rem 0.75rem;
      color: var(--friends-muted);
      font-family: "Noto Sans Mono", monospace;
      font-size: 0.62rem;
      letter-spacing: 0.08em;
      line-height: 1.4;
      text-transform: uppercase;
    }

    .friend-group__count {
      color: var(--friends-ink);
      font-weight: 700;
      letter-spacing: 0;
      text-transform: none;
    }

    .friend-group__heading h2 {
      position: relative;
      display: inline-block;
      margin: 0.15rem 0 0;
      color: var(--friends-ink);
      font-size: clamp(1.25rem, 2.3vw, 1.65rem);
      font-weight: 800;
      line-height: 1.35;
    }

    .friend-group__heading h2::first-letter {
      color: var(--friends-accent);
    }

    .friend-group__heading p {
      max-width: 42rem;
      margin: 0.25rem 0 0;
      color: var(--friends-muted);
      font-size: 0.8rem;
      line-height: 1.65;
    }

    .friends-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      align-items: stretch;
      gap: 20px;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .friend-card {
      --fcl-tilt: -0.25deg;
      --fcl-tape-color: var(--friends-tape-0);
      --fcl-tab-color: var(--friends-tab-0);
      position: relative;
      z-index: 1;
      border-radius: 10px;
      background: var(--friends-card-bg);
      box-shadow: var(--friends-card-shadow);
      isolation: isolate;
      transform: rotate(var(--fcl-tilt));
      transition:
        transform 0.22s ease,
        border-color 0.22s ease,
        box-shadow 0.22s ease;
    }

    .friend-card:nth-child(4n + 2) {
      --fcl-tilt: 0.22deg;
      --fcl-tape-color: var(--friends-tape-1);
      --fcl-tab-color: var(--friends-tab-1);
    }

    .friend-card:nth-child(4n + 3) {
      --fcl-tilt: -0.12deg;
      --fcl-tape-color: var(--friends-tape-2);
      --fcl-tab-color: var(--friends-tab-2);
    }

    .friend-card:nth-child(4n + 4) {
      --fcl-tilt: 0.3deg;
      --fcl-tape-color: var(--friends-tape-3);
      --fcl-tab-color: var(--friends-tab-3);
    }

    .friend-card:hover {
      z-index: 10;
    }

    .friend-card::before,
    .friend-card::after {
      content: "";
      position: absolute;
      pointer-events: none;
    }

    .friend-card::before {
      top: -8px;
      left: 22px;
      z-index: 5;
      width: 38px;
      height: 15px;
      background-color: var(--fcl-tape-color);
      background-image: repeating-linear-gradient(
        90deg,
        transparent,
        transparent 3px,
        rgba(255, 255, 255, 0.35) 3px,
        rgba(255, 255, 255, 0.35) 5px,
        transparent 5px,
        transparent 10px
      );
      box-shadow: 0 3px 8px rgba(82, 64, 38, 0.12);
      filter: saturate(0.92);
      transform: rotate(-3deg);
      border-radius: 2px;
    }

    html.dark .friend-card::before {
      box-shadow: 0 3px 8px rgba(0, 0, 0, 0.24);
    }

    .friend-card::after {
      top: 16px;
      right: -6px;
      z-index: -1;
      width: 6px;
      height: 48px;
      border: 1px dashed rgba(82, 64, 38, 0.12);
      border-left: 0;
      border-radius: 0 8px 8px 0;
      background: var(--fcl-tab-color);
      box-shadow: 2px 3px 0 rgba(82, 64, 38, 0.08);
      transition:
        width 0.25s cubic-bezier(0.34, 1.56, 0.64, 1),
        right 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    html.dark .friend-card::after {
      border-color: rgba(225, 230, 245, 0.1);
      box-shadow: 3px 4px 0 rgba(0, 0, 0, 0.16);
    }

    .friend-card:hover {
      transform: translateY(-3px) rotate(0deg);
    }

    .friend-card:hover::after {
      right: -12px;
      width: 12px;
    }

    .friend-shot {
      position: relative;
      height: 10rem;
      overflow: hidden;
      border-radius: 10px 10px 0 0;
      background: var(--friends-shot-fallback);
    }

    .friend-shot-image {
      height: 100%;
      width: 100%;
      object-fit: cover;
      transition: transform 0.45s ease;
    }

    .friend-card:hover .friend-shot-image {
      transform: scale(1.03);
    }

    .friend-shot-fallback {
      height: 100%;
      width: 100%;
      background: var(--friends-shot-fallback);
    }

    .friend-shot-mask {
      position: absolute;
      inset: 0;
      background: var(--friends-shot-mask);
    }

    .friend-latency {
      position: absolute;
      top: 0.8rem;
      right: 0.8rem;
      z-index: 3;
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      border-radius: 999px;
      border: 1px solid transparent;
      padding: 0.3rem 0.65rem;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      backdrop-filter: blur(10px);
    }

    .friend-latency-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: currentColor;
      flex-shrink: 0;
    }

    .friend-latency--fast,
    .friend-latency--ok {
      background: color-mix(in srgb, #86d993 28%, transparent);
      border-color: color-mix(in srgb, #86d993 50%, transparent);
      color: #166534;
    }

    html.dark .friend-latency--fast,
    html.dark .friend-latency--ok {
      background: #22c55e;
      border-color: #16a34a;
      color: #fff;
      backdrop-filter: none;
    }

    .friend-latency--slow {
      background: rgba(245, 158, 11, 0.14);
      border-color: rgba(245, 158, 11, 0.3);
      color: #b45309;
    }

    html.dark .friend-latency--slow {
      background: #f59e0b;
      border-color: #d97706;
      color: #fff;
      backdrop-filter: none;
    }

    .friend-latency--down {
      background: rgba(244, 63, 94, 0.14);
      border-color: rgba(244, 63, 94, 0.3);
      color: #be123c;
    }

    html.dark .friend-latency--down {
      background: #f43f5e;
      border-color: #e11d48;
      color: #fff;
      backdrop-filter: none;
    }

    .friend-latency--idle {
      background: rgba(113, 113, 122, 0.12);
      border-color: rgba(113, 113, 122, 0.18);
      color: var(--friends-muted);
    }

    html.dark .friend-latency--idle {
      background: #71717a;
      border-color: #52525b;
      color: #fff;
      backdrop-filter: none;
    }

    .friend-card__main {
      position: relative;
      display: flex;
      align-items: flex-start;
      gap: 12px;
      padding: 14px 18px 0;
      margin-top: -1.5rem;
    }

    .friend-card__link {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      min-width: 0;
      flex: 1;
      text-decoration: none;
      color: inherit;
    }

    img.friend-card__avatar {
      flex-shrink: 0;
      display: block;
      width: 58px;
      height: 58px;
      border: 1px solid var(--friends-avatar-border);
      border-radius: 9px;
      background: var(--friends-card-bg);
      box-shadow: var(--friends-avatar-shadow);
      object-fit: cover;
      transform: rotate(-2deg);
      transition:
        transform 0.22s ease,
        border-color 0.22s ease,
        box-shadow 0.22s ease;
    }

    .friend-card:hover img.friend-card__avatar {
      border-color: var(--friends-accent);
      box-shadow: 3px 5px 0 rgba(82, 64, 38, 0.1);
      transform: rotate(0deg) translateY(-1px);
    }

    html.dark .friend-card:hover img.friend-card__avatar {
      box-shadow: 3px 5px 0 rgba(0, 0, 0, 0.22);
    }

    .friend-card__body {
      min-width: 0;
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 2px;
      padding-top: 8px;
    }

    .friend-card__name {
      font-size: 15px;
      font-weight: 700;
      line-height: 1.4;
      color: var(--friends-ink);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .friend-card:hover .friend-card__name {
      color: var(--friends-accent);
    }

    .friend-card__host {
      font-size: 11px;
      color: var(--friends-muted);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .friend-card__desc {
      margin-top: 3px;
      color: var(--friends-muted);
      font-size: 12px;
      line-height: 1.55;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .friend-card__rss {
      flex-shrink: 0;
      display: inline-grid;
      place-items: center;
      width: 28px;
      height: 28px;
      margin-top: 6px;
      border-radius: 50%;
      color: var(--friends-muted);
      background: transparent;
      transition:
        color 0.25s ease,
        background 0.25s ease,
        transform 0.25s ease;
    }

    .friend-card__rss::before {
      content: "";
      position: absolute;
      inset: 0;
      border-radius: 50%;
      border: 1.5px solid currentColor;
      opacity: 0;
      pointer-events: none;
    }

    .friend-card:hover .friend-card__rss {
      color: var(--friends-accent);
      background: color-mix(in srgb, var(--friends-accent) 12%, transparent);
    }

    html.dark .friend-card:hover .friend-card__rss {
      color: var(--friends-accent);
      background: color-mix(in srgb, var(--friends-accent) 15%, transparent);
    }

    .friend-card__rss:hover {
      transform: scale(1.12);
    }

    .friend-card__rss .lucide {
      width: 13px;
      height: 13px;
      transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .friend-card:hover .friend-card__rss .lucide {
      animation: fcl-rss-wiggle 0.7s ease;
    }

    @keyframes fcl-rss-wiggle {
      0% {
        transform: rotate(0) scale(1);
      }
      25% {
        transform: rotate(-8deg) scale(1.08);
      }
      50% {
        transform: rotate(6deg) scale(1.12);
      }
      75% {
        transform: rotate(-3deg) scale(1.06);
      }
      100% {
        transform: rotate(0) scale(1);
      }
    }

    .friend-card__extra {
      padding: 12px 18px 16px;
    }

    .friend-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-bottom: 0.8rem;
    }

    .friend-tag {
      border-radius: 999px;
      background: var(--friends-tag-bg);
      padding: 0.25rem 0.6rem;
      font-size: 0.7rem;
      color: var(--friends-muted);
    }

    .friend-meta-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.7rem;
    }

    .friend-meta-box {
      border: 1px dashed var(--friends-card-border);
      border-radius: 8px;
      background: var(--friends-meta-bg);
      padding: 0.6rem 0.8rem;
    }

    .friend-meta-label {
      font-size: 0.65rem;
      color: var(--friends-muted);
      margin-bottom: 0.2rem;
    }

    .friend-meta-value {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      font-size: 0.85rem;
      font-weight: 500;
      color: var(--friends-ink);
    }

    .friend-meta-box--link {
      display: block;
      color: inherit;
      text-decoration: none;
      transition:
        border-color 0.2s ease,
        color 0.2s ease,
        background-color 0.2s ease;
    }

    .friend-meta-box--link:hover {
      border-color: var(--friends-accent);
      background: color-mix(in srgb, var(--friends-accent) 8%, transparent);
    }

    .friend-meta-box--link:hover .friend-meta-value {
      color: var(--friends-accent);
    }

    .friend-card__link:focus-visible,
    .friend-card__rss:focus-visible,
    .friend-meta-box--link:focus-visible {
      outline: 2px solid var(--friends-accent);
      outline-offset: 3px;
    }

    @media (max-width: 1024px) {
      .friends-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 640px) {
      .friend-groups {
        gap: 2.75rem;
      }

      .failed-friends {
        padding: 1rem;
      }

      .failed-friends__list {
        gap: 0.6rem 0.8rem;
      }

      .friend-application {
        align-items: flex-start;
        flex-direction: column;
      }

      .friend-group__header {
        gap: 0.65rem;
        margin-bottom: 1rem;
        padding-bottom: 0.8rem;
      }

      .friend-group__tab {
        min-height: 1.75rem;
        padding: 0.3rem 0.5rem;
        font-size: 0.5rem;
        letter-spacing: 0.08em;
      }

      .friend-group__tab-mark {
        width: 0.35rem;
        height: 0.35rem;
      }

      .friend-group__eyebrow {
        font-size: 0.55rem;
      }

      .friend-group__heading h2 {
        font-size: 1.2rem;
      }

      .friend-group__heading p {
        font-size: 0.75rem;
      }

      .friends-grid {
        grid-template-columns: 1fr;
        gap: 18px;
      }

      .friend-card {
        transform: none;
      }

      .friend-card:hover {
        transform: translateY(-2px);
      }

      .friend-card::before {
        left: 16px;
      }

      .friend-card::after {
        top: 18px;
        right: -5px;
        width: 5px;
        height: 38px;
      }

      .friend-card:hover::after {
        right: -9px;
        width: 9px;
      }

      .friend-shot {
        height: 8rem;
      }

      .friend-card__main {
        padding: 12px 14px 0;
        gap: 10px;
      }

      .friend-card__link {
        gap: 10px;
      }

      img.friend-card__avatar {
        width: 48px;
        height: 48px;
        border-radius: 7px;
      }

      .friend-card__extra {
        padding: 10px 14px 14px;
      }

      .friend-meta-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .friend-card__rss {
        margin-top: 4px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .friend-card,
      .friend-card::after,
      .friend-shot-image,
      .friend-card__avatar,
      .friend-card__rss,
      .friend-card__rss .lucide,
      .friend-meta-box--link {
        transition: none;
      }

      .friend-card,
      .friend-card:hover,
      .friend-card__avatar,
      .friend-card:hover img.friend-card__avatar,
      .friend-card__rss:hover {
        transform: none;
      }

      .friend-card:hover .friend-shot-image,
      .friend-card:hover .friend-card__rss .lucide {
        animation: none;
        transform: none;
      }
    }
  </style>

  <script>
    import { load as yamlLoad } from "js-yaml/browser";
    import { FRIEND_FALSE_DATA_URL, LATENCY_API_URL } from "../../consts";
    import {
      getHttpUrl,
      loadFriendGroups,
      type FriendItem,
    } from "../../lib/friends-client";

    interface FalseLinkEntry {
      name?: unknown;
      avatar?: unknown;
    }

    interface FalseLinkRecord {
      entry?: FalseLinkEntry;
    }

    interface RemoteLinkItem {
      link?: unknown;
      link_page?: unknown;
      latency?: unknown;
      reachable?: unknown;
    }

    interface RemoteLinkPayload {
      link_data?: unknown;
    }

    interface LatencyInfo {
      latency?: number;
      reachable?: boolean;
    }

    const getHost = (url: string) => new URL(url).host.replace(/^www\./, "");

    const formatLatency = (latency?: number) => {
      if (!latency || Number.isNaN(latency)) return "检测中";
      return latency < 1
        ? `${Math.round(latency * 1000)} MS`
        : `${latency.toFixed(1)} S`;
    };

    const getLatencyTone = (latency?: number, reachable?: boolean) => {
      if (reachable === false) return "down";
      if (!latency || Number.isNaN(latency)) return "idle";
      if (latency < 0.8) return "fast";
      if (latency < 1.8) return "ok";
      return "slow";
    };

    const createTextElement = (
      tag: string,
      className: string,
      text: string,
    ) => {
      const element = document.createElement(tag);
      element.className = className;
      element.textContent = text;
      return element;
    };

    const createExternalLink = (href: string, className: string) => {
      const link = document.createElement("a");
      link.href = href;
      link.target = "_blank";
      link.rel = "noopener noreferrer";
      link.className = className;
      return link;
    };

    const createLatencyBadge = () => {
      const badge = document.createElement("span");
      badge.className = "friend-latency friend-latency--idle";
      const dot = document.createElement("span");
      dot.className = "friend-latency-dot";
      badge.append(dot, document.createTextNode("检测中"));
      return badge;
    };

    const createRssIcon = () => {
      const namespace = "http://www.w3.org/2000/svg";
      const icon = document.createElementNS(namespace, "svg");
      icon.setAttribute("xmlns", namespace);
      icon.setAttribute("width", "13");
      icon.setAttribute("height", "13");
      icon.setAttribute("viewBox", "0 0 24 24");
      icon.setAttribute("fill", "none");
      icon.setAttribute("stroke", "currentColor");
      icon.setAttribute("stroke-width", "2.5");
      icon.setAttribute("stroke-linecap", "round");
      icon.setAttribute("stroke-linejoin", "round");
      icon.setAttribute("class", "lucide");

      for (const attributes of [
        { d: "M4 11a9 9 0 0 1 9 9" },
        { d: "M4 4a16 16 0 0 1 16 16" },
        { cx: "5", cy: "19", r: "1" },
      ]) {
        const shape = document.createElementNS(
          namespace,
          "d" in attributes ? "path" : "circle",
        );
        for (const [name, value] of Object.entries(attributes)) {
          shape.setAttribute(name, value);
        }
        icon.append(shape);
      }

      return icon;
    };

    const createFriendCard = (friend: FriendItem) => {
      const card = document.createElement("article");
      card.className = "friend-card";

      const shot = document.createElement("div");
      shot.className = "friend-shot";
      if (friend.snapshot) {
        const image = document.createElement("img");
        image.src = friend.snapshot;
        image.alt = "";
        image.className = "friend-shot-image";
        image.loading = "lazy";
        image.addEventListener(
          "error",
          () =>
            image.replaceWith(
              Object.assign(document.createElement("div"), {
                className: "friend-shot-fallback",
              }),
            ),
          { once: true },
        );
        shot.append(image);
      } else {
        shot.append(
          Object.assign(document.createElement("div"), {
            className: "friend-shot-fallback",
          }),
        );
      }
      shot.append(
        Object.assign(document.createElement("div"), {
          className: "friend-shot-mask",
        }),
        createLatencyBadge(),
      );

      const main = document.createElement("div");
      main.className = "friend-card__main";
      const link = createExternalLink(friend.url, "friend-card__link");
      if (friend.avatar) {
        const avatar = document.createElement("img");
        avatar.src = friend.avatar;
        avatar.alt = friend.name;
        avatar.className = "friend-card__avatar";
        avatar.loading = "lazy";
        avatar.addEventListener("error", () => avatar.remove(), { once: true });
        link.append(avatar);
      }
      const body = document.createElement("span");
      body.className = "friend-card__body";
      body.append(
        createTextElement("strong", "friend-card__name", friend.name),
        createTextElement("span", "friend-card__host", getHost(friend.url)),
        createTextElement(
          "span",
          "friend-card__desc",
          friend.desc || "这个朋友暂时还没有补充简介。",
        ),
      );
      link.append(body);
      main.append(link);

      if (friend.feed) {
        const rss = createExternalLink(friend.feed, "friend-card__rss");
        rss.setAttribute("aria-label", `${friend.name} 的 RSS`);
        rss.title = "RSS";
        rss.append(createRssIcon());
        main.append(rss);
      }

      const extra = document.createElement("div");
      extra.className = "friend-card__extra";
      if (friend.tags.length > 0) {
        const tags = document.createElement("div");
        tags.className = "friend-tags";
        tags.setAttribute("aria-label", "站点标签");
        tags.append(
          ...friend.tags.map((tag) =>
            createTextElement("span", "friend-tag", tag),
          ),
        );
        extra.append(tags);
      }

      const meta = document.createElement("div");
      meta.className = "friend-meta-grid";
      const host = getHost(friend.url);
      const createMeta = (label: string, value: string) => {
        const box = document.createElement("div");
        box.className = "friend-meta-box";
        box.append(
          createTextElement("div", "friend-meta-label", label),
          createTextElement("span", "friend-meta-value", value),
        );
        return box;
      };
      meta.append(
        createMeta("主站", host),
        createMeta("订阅", friend.feed ? "已提供" : "未提供"),
      );
      if (friend.links) {
        const links = createExternalLink(
          friend.links,
          "friend-meta-box friend-meta-box--link",
        );
        links.setAttribute("aria-label", `访问 ${friend.name} 的友链页面`);
        links.append(
          createTextElement("span", "friend-meta-label", "友链页"),
          createTextElement("span", "friend-meta-value", "访问页面 ↗"),
        );
        meta.append(links);
      } else {
        meta.append(createMeta("友链页", "未提供"));
      }
      extra.append(meta);

      card.append(shot, main, extra);
      return card;
    };

    const createFriendGroup = (
      group: { name: string; description: string; friends: FriendItem[] },
      index: number,
    ) => {
      const section = document.createElement("section");
      section.className = `friend-group friend-group--${index % 4}`;
      const headingId = `friend-group-${index}`;
      section.setAttribute("aria-labelledby", headingId);

      const header = document.createElement("header");
      header.className = "friend-group__header";
      const tab = document.createElement("div");
      tab.className = "friend-group__tab";
      tab.setAttribute("aria-hidden", "true");
      tab.append(
        Object.assign(document.createElement("span"), {
          className: "friend-group__tab-mark",
        }),
        createTextElement("span", "", "LINKS"),
      );
      const heading = document.createElement("div");
      heading.className = "friend-group__heading";
      const eyebrow = document.createElement("div");
      eyebrow.className = "friend-group__eyebrow";
      eyebrow.append(
        createTextElement("span", "", "FRIEND GROUP"),
        createTextElement(
          "span",
          "friend-group__count",
          `${group.friends.length} 位朋友`,
        ),
      );
      const title = createTextElement("h2", "", group.name);
      title.id = headingId;
      heading.append(eyebrow, title);
      if (group.description) {
        heading.append(createTextElement("p", "", group.description));
      }
      header.append(tab, heading);

      const grid = document.createElement("div");
      grid.className = "friends-grid";
      grid.append(...group.friends.map(createFriendCard));
      section.append(header, grid);
      return section;
    };

    const getLatencyMap = async () => {
      const response = await fetch(LATENCY_API_URL, { cache: "no-store" });
      if (!response.ok) {
        throw new Error(`Failed to fetch latency data: ${response.status}`);
      }

      const payload = (await response.json()) as RemoteLinkPayload;
      if (!Array.isArray(payload.link_data)) {
        throw new Error("Unexpected latency data structure");
      }

      return new Map(
        payload.link_data.flatMap((value) => {
          if (!value || typeof value !== "object") return [];
          const item = value as RemoteLinkItem;
          const payload: LatencyInfo = {
            latency:
              typeof item.latency === "number" ? item.latency : undefined,
            reachable:
              typeof item.reachable === "boolean" ? item.reachable : undefined,
          };
          return [getHttpUrl(item.link), getHttpUrl(item.link_page)]
            .filter(Boolean)
            .map((url) => [url, payload] as const);
        }),
      );
    };

    const applyLatency = (
      friends: FriendItem[],
      latencyMap: Map<string, LatencyInfo>,
    ) => {
      const cards = document.querySelectorAll<HTMLElement>(".friend-card");
      for (const [index, friend] of friends.entries()) {
        const badge =
          cards[index]?.querySelector<HTMLElement>(".friend-latency");
        if (!badge) continue;

        const info = latencyMap.get(friend.url) ?? latencyMap.get(friend.links);
        const tone = getLatencyTone(info?.latency, info?.reachable);
        badge.className = `friend-latency friend-latency--${tone}`;
        badge.replaceChildren(
          Object.assign(document.createElement("span"), {
            className: "friend-latency-dot",
          }),
          document.createTextNode(formatLatency(info?.latency)),
        );
      }
    };

    const getFalseLinkEntries = (value: unknown): FalseLinkEntry[] => {
      if (!Array.isArray(value)) return [];

      return value.flatMap((record: FalseLinkRecord) => {
        const entry = record?.entry;
        const name = typeof entry?.name === "string" ? entry.name.trim() : "";
        return name ? [{ ...entry, name }] : [];
      });
    };

    const createFalseLinkItem = (entry: FalseLinkEntry) => {
      const item = document.createElement("li");
      item.className = "failed-friends__item";
      const avatar = getHttpUrl(entry.avatar);
      if (avatar) {
        const image = document.createElement("img");
        image.className = "failed-friends__avatar";
        image.src = avatar;
        image.alt = "";
        image.loading = "lazy";
        image.addEventListener("error", () => image.remove(), { once: true });
        item.append(image);
      }
      item.append(
        createTextElement("span", "failed-friends__name", entry.name as string),
      );
      return item;
    };

    const loadFalseFriends = async () => {
      const section = document.querySelector<HTMLElement>("#failed-friends");
      const list = document.querySelector<HTMLUListElement>(
        "#failed-friends-list",
      );
      if (!section || !list) return;

      section.hidden = true;
      list.replaceChildren();
      try {
        const response = await fetch(FRIEND_FALSE_DATA_URL, {
          cache: "no-store",
        });
        if (!response.ok) {
          throw new Error(`Failed to fetch false friends: ${response.status}`);
        }
        const entries = getFalseLinkEntries(yamlLoad(await response.text()));
        if (entries.length === 0) return;
        list.append(...entries.map(createFalseLinkItem));
        section.hidden = false;
      } catch (error) {
        console.warn("Failed to load false friends:", error);
      }
    };

    const loadFriends = async () => {
      const groupsContainer =
        document.querySelector<HTMLElement>("#friend-groups");
      const total = document.querySelector<HTMLElement>("#friends-total");
      const groupTotal = document.querySelector<HTMLElement>(
        "#friends-group-total",
      );
      if (!groupsContainer || !total || !groupTotal) return;

      groupsContainer.replaceChildren(
        createTextElement("p", "friend-groups__status", "正在加载友链…"),
      );
      total.textContent = "正在加载友链…";
      groupTotal.textContent = "正在加载分组…";

      const latencyPromise = getLatencyMap().catch((error) => {
        console.warn("Failed to load latency data:", error);
        return null;
      });

      try {
        const groups = await loadFriendGroups();
        const friends = groups.flatMap((group) => group.friends);
        if (friends.length === 0) {
          throw new Error("No valid friends in remote data");
        }

        groupsContainer.replaceChildren(
          ...groups.map((group, index) => createFriendGroup(group, index)),
        );
        total.textContent = `共 ${friends.length} 位朋友`;
        groupTotal.textContent = `${groups.length} 个分组`;

        const latencyMap = await latencyPromise;
        if (latencyMap) applyLatency(friends, latencyMap);
      } catch (error) {
        console.warn("Failed to load friends:", error);
        const message = createTextElement(
          "p",
          "friend-groups__status",
          "友链数据暂时无法加载，请稍后刷新重试。",
        );
        message.setAttribute("role", "alert");
        groupsContainer.replaceChildren(message);
        total.textContent = "友链数据加载失败";
        groupTotal.textContent = "分组数据加载失败";
      }
    };

    document.addEventListener("astro:page-load", () => {
      void loadFriends();
      void loadFalseFriends();
    });
  </script>
</Layout>
