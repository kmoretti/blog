---
import { LATENCY_API_URL } from "../../consts";
import Layout from "../../layouts/Layout.astro";
import { fetchFriendGroups } from "../../lib/friends";

interface RemoteLinkItem {
  name?: string;
  link?: string;
  link_page?: string;
  latency?: number;
  reachable?: boolean;
}

interface RemoteLinkPayload {
  link_data?: RemoteLinkItem[];
}

const pageTitle = "友链详情 | 喵洛阁";
const pageDescription = "友情链接详细页面";

const normalizeUrl = (value?: string) =>
  value?.trim().replace(/^`|`$/g, "").replace(/\/+$/, "") ?? "";
const normalizeTagList = (value?: string) =>
  (value ?? "")
    .split(",")
    .map((item) => item.trim())
    .filter(Boolean);

const getHost = (value: string) => {
  try {
    return new URL(value).host.replace(/^www\./, "");
  } catch {
    return value;
  }
};

const formatLatency = (latency?: number) => {
  if (!latency || Number.isNaN(latency)) return "检测中";
  return latency < 1
    ? `${Math.round(latency * 1000)} MS`
    : `${latency.toFixed(1)} S`;
};

const getLatencyTone = (latency?: number, reachable?: boolean) => {
  if (reachable === false) return "down";
  if (!latency || Number.isNaN(latency)) return "idle";
  if (latency < 0.8) return "fast";
  if (latency < 1.8) return "ok";
  return "slow";
};

const friendGroupsData = await fetchFriendGroups();

let latencyMap = new Map<string, { latency?: number; reachable?: boolean }>();

try {
  const response = await fetch(LATENCY_API_URL);
  const remoteData = (await response.json()) as RemoteLinkPayload;
  latencyMap = new Map(
    (remoteData.link_data ?? []).flatMap((item) => {
      const entries: [string, { latency?: number; reachable?: boolean }][] = [];
      const payload = { latency: item.latency, reachable: item.reachable };
      if (item.link) entries.push([normalizeUrl(item.link), payload]);
      if (item.link_page) entries.push([normalizeUrl(item.link_page), payload]);
      return entries;
    }),
  );
} catch {
  latencyMap = new Map();
}

const friendGroups = friendGroupsData.map((group) => ({
  ...group,
  friends: group.friends.map((friend) => {
    const siteUrl = normalizeUrl(friend.url);
    const linksUrl = normalizeUrl(friend.links);
    const latencyInfo = latencyMap.get(siteUrl) ?? latencyMap.get(linksUrl);

    return {
      ...friend,
      url: siteUrl,
      links: linksUrl,
      snapshot: normalizeUrl(friend.snapshot),
      feed: normalizeUrl(friend.feed),
      desc: friend.desc?.trim() ?? "",
      tags: normalizeTagList(friend.tags),
      host: getHost(siteUrl),
      latency: latencyInfo?.latency,
      reachable: latencyInfo?.reachable,
      latencyText: formatLatency(latencyInfo?.latency),
      latencyTone: getLatencyTone(latencyInfo?.latency, latencyInfo?.reachable),
    };
  }),
}));

const friends = friendGroups.flatMap((group) => group.friends);
---

<Layout
  title={pageTitle}
  description={pageDescription}
  className="max-w-[1100px] px-4 py-6"
>
  <main class="friends-detail space-y-8">
    <header class="space-y-4">
      <div class="flex items-start justify-between gap-4">
        <div class="space-y-2">
          <nav aria-label="Breadcrumb" class="fp-breadcrumb">
            <a href="/">喵洛阁</a>
            <span class="mx-1">/</span>
            <a href="/friends/">朋友们</a>
            <span class="mx-1">/</span>
          </nav>
          <h1 class="fp-heading text-2xl font-semibold">友链详情</h1>
          <p class="fp-subtext max-w-2xl text-sm leading-6">
            欢迎大家来加入友链~
          </p>
          <p class="friend-data-note" role="note">
            友链数据使用 CDN 加速，更新可能需要一些时间。
          </p>
        </div>
        <div class="flex shrink-0 gap-2">
          <a
            href="/friends/fcircle/"
            class="fp-link-btn inline-flex items-center rounded-full px-3 py-1.5 text-sm transition"
          >
            朋友圈
          </a>
          <a
            href="/friends/"
            class="fp-link-btn inline-flex items-center rounded-full px-3 py-1.5 text-sm transition"
          >
            简洁视图
          </a>
        </div>
      </div>
      <div class="fp-muted flex flex-wrap gap-2 text-xs">
        <span class="fp-tag rounded-full px-3 py-1">
          共 {friends.length} 位朋友
        </span>
        <span class="fp-tag rounded-full px-3 py-1">
          {friendGroups.length} 个分组
        </span>
        <span class="fp-tag rounded-full px-3 py-1">
          延迟数据源：fc.081531.xyz
        </span>
      </div>
    </header>

    <div class="friend-groups">
      {
        friendGroups.map((group, groupIndex) => (
          <section
            class={`friend-group friend-group--${groupIndex % 4}`}
            aria-labelledby={`friend-group-${groupIndex}`}
          >
            <header class="friend-group__header">
              <div class="friend-group__tab" aria-hidden="true">
                <span class="friend-group__tab-mark" />
                <span>LINKS</span>
              </div>
              <div class="friend-group__heading">
                <div class="friend-group__eyebrow">
                  <span>FRIEND GROUP</span>
                  <span class="friend-group__count">
                    {group.friends.length} 位朋友
                  </span>
                </div>
                <h2 id={`friend-group-${groupIndex}`}>{group.name}</h2>
                {group.description && <p>{group.description}</p>}
              </div>
            </header>

            <div class="friends-grid">
              {group.friends.map((friend) => (
                <article class="friend-card">
                  <div class="friend-shot">
                    {friend.snapshot ? (
                      <img
                        src={friend.snapshot}
                        alt=""
                        class="friend-shot-image"
                        loading="lazy"
                      />
                    ) : (
                      <div class="friend-shot-fallback" />
                    )}
                    <div class="friend-shot-mask" />
                    <span
                      class={`friend-latency friend-latency--${friend.latencyTone}`}
                    >
                      <span class="friend-latency-dot" />
                      {friend.latencyText}
                    </span>
                  </div>

                  <div class="friend-card__main">
                    <a
                      href={friend.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="friend-card__link"
                    >
                      <img
                        src={friend.avatar}
                        alt={friend.name}
                        class="friend-card__avatar"
                        loading="lazy"
                      />
                      <span class="friend-card__body">
                        <strong class="friend-card__name">{friend.name}</strong>
                        <span class="friend-card__host">{friend.host}</span>
                        <span class="friend-card__desc">
                          {friend.desc || "这个朋友暂时还没有补充简介。"}
                        </span>
                      </span>
                    </a>

                    {friend.feed && (
                      <a
                        href={friend.feed}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="friend-card__rss"
                        aria-label={`${friend.name} 的 RSS`}
                        title="RSS"
                      >
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          width="13"
                          height="13"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          class="lucide"
                        >
                          <path d="M4 11a9 9 0 0 1 9 9" />
                          <path d="M4 4a16 16 0 0 1 16 16" />
                          <circle cx="5" cy="19" r="1" />
                        </svg>
                      </a>
                    )}
                  </div>

                  <div class="friend-card__extra">
                    {friend.tags.length > 0 && (
                      <div class="friend-tags" aria-label="站点标签">
                        {friend.tags.map((tag) => (
                          <span class="friend-tag">{tag}</span>
                        ))}
                      </div>
                    )}

                    <div class="friend-meta-grid">
                      <div class="friend-meta-box">
                        <div class="friend-meta-label">主站</div>
                        <div class="friend-meta-value">{friend.host}</div>
                      </div>
                      <div class="friend-meta-box">
                        <div class="friend-meta-label">订阅</div>
                        {friend.feed ? (
                          <span class="friend-meta-value">已提供</span>
                        ) : (
                          <span class="friend-meta-value">未提供</span>
                        )}
                      </div>
                      {friend.links ? (
                        <a
                          href={friend.links}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="friend-meta-box friend-meta-box--link"
                          aria-label={`访问 ${friend.name} 的友链页面`}
                        >
                          <span class="friend-meta-label">友链页</span>
                          <span class="friend-meta-value">访问页面 ↗</span>
                        </a>
                      ) : (
                        <div class="friend-meta-box">
                          <div class="friend-meta-label">友链页</div>
                          <span class="friend-meta-value">未提供</span>
                        </div>
                      )}
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </main>

  <style is:inline>
    .fp-breadcrumb {
      color: var(--fp-muted);
      font-size: 0.8125rem;
    }
    .fp-breadcrumb a {
      color: inherit;
      text-decoration: none;
    }
    .fp-breadcrumb a:hover {
      text-decoration: underline;
    }
    .fp-breadcrumb strong {
      color: var(--fp-ink);
      font-weight: 600;
    }
    .fp-heading {
      color: var(--fp-ink);
    }
    .fp-subtext {
      color: var(--fp-ink-soft);
    }
    .friend-data-note {
      display: inline-flex;
      align-items: center;
      width: fit-content;
      margin: 0;
      border-left: 3px solid var(--fp-accent-muted);
      padding: 0.35rem 0.65rem;
      background: color-mix(in srgb, var(--fp-accent) 12%, transparent);
      color: var(--fp-muted);
      font-size: 0.75rem;
      line-height: 1.5;
    }
    .fp-muted {
      color: var(--fp-muted);
    }
    .fp-link-btn {
      border: 1px solid var(--fp-dash);
      background: var(--fp-paper);
      color: var(--fp-ink-soft);
    }
    .fp-link-btn:hover {
      border-color: var(--fp-accent);
      color: var(--fp-ink);
    }
    .fp-divider {
      border-color: var(--fp-dash);
    }
    .fp-divider-text {
      color: var(--fp-dash);
    }
    .fp-tag {
      border: 1px solid var(--fp-dash);
    }

    .friends-detail {
      --friends-tape-0: #f5d742;
      --friends-tape-1: #f09bc0;
      --friends-tape-2: #86d993;
      --friends-tape-3: #87b9e8;
      --friends-tab-0: #7cb87c;
      --friends-tab-1: #6ba8d6;
      --friends-tab-2: #f5d742;
      --friends-tab-3: #e8a0b8;
      --friends-card-bg: rgba(255, 255, 255, 0.92);
      --friends-card-border: rgba(24, 24, 27, 0.1);
      --friends-card-shadow:
        4px 5px 0 rgba(82, 64, 38, 0.08), 0 2px 8px rgba(15, 23, 42, 0.06);
      --friends-avatar-border: rgba(82, 64, 38, 0.12);
      --friends-avatar-shadow: 2px 3px 0 rgba(82, 64, 38, 0.08);
      --friends-shot-fallback: linear-gradient(
        135deg,
        rgba(245, 215, 66, 0.3),
        rgba(255, 255, 255, 0.92)
      );
      --friends-shot-mask: linear-gradient(
        to top,
        rgba(255, 255, 255, 0.98),
        rgba(255, 255, 255, 0.15) 45%,
        rgba(255, 255, 255, 0.02)
      );
      --friends-tag-bg: rgba(24, 24, 27, 0.04);
      --friends-meta-bg: rgba(24, 24, 27, 0.03);
      --friends-muted: #71717a;
      --friends-ink: #18181b;
      --friends-accent: #2563eb;
    }

    html.dark .friends-detail {
      --friends-tape-0: #a8862a;
      --friends-tape-1: #9e5f7a;
      --friends-tape-2: #4f7a55;
      --friends-tape-3: #4f6f8a;
      --friends-tab-0: #4a7a4a;
      --friends-tab-1: #3d6a8a;
      --friends-tab-2: #a8862a;
      --friends-tab-3: #8a5f70;
      --friends-card-bg: rgba(24, 24, 27, 0.88);
      --friends-card-border: rgba(255, 255, 255, 0.06);
      --friends-card-shadow:
        4px 5px 0 rgba(0, 0, 0, 0.2), 0 2px 8px rgba(0, 0, 0, 0.12);
      --friends-avatar-border: rgba(225, 230, 245, 0.12);
      --friends-avatar-shadow: 2px 3px 0 rgba(0, 0, 0, 0.18);
      --friends-shot-fallback: linear-gradient(
        135deg,
        rgba(168, 134, 42, 0.2),
        rgba(24, 24, 27, 0.9)
      );
      --friends-shot-mask: linear-gradient(
        to top,
        rgba(24, 24, 27, 0.98),
        rgba(24, 24, 27, 0.2) 45%,
        rgba(24, 24, 27, 0.04)
      );
      --friends-tag-bg: rgba(255, 255, 255, 0.06);
      --friends-meta-bg: rgba(255, 255, 255, 0.04);
      --friends-muted: #a1a1aa;
      --friends-ink: #e4e4e7;
      --friends-accent: #93c5fd;
    }

    .friend-groups {
      display: flex;
      flex-direction: column;
      gap: 3.25rem;
    }

    .friend-group {
      --friends-group-color: var(--friends-tape-0);
      --friends-group-tilt: -2deg;
    }

    .friend-group--1 {
      --friends-group-color: var(--friends-tape-1);
      --friends-group-tilt: 2deg;
    }

    .friend-group--2 {
      --friends-group-color: var(--friends-tape-2);
      --friends-group-tilt: -1.5deg;
    }

    .friend-group--3 {
      --friends-group-color: var(--friends-tape-3);
      --friends-group-tilt: 1.5deg;
    }

    .friend-group__header {
      position: relative;
      display: flex;
      align-items: flex-start;
      gap: 1rem;
      margin-bottom: 1.25rem;
      padding: 0 0 1rem;
      border-bottom: 1px dashed var(--friends-card-border);
    }

    .friend-group__header::after {
      content: "";
      position: absolute;
      bottom: -3px;
      left: 0;
      width: 5.5rem;
      height: 5px;
      background: var(--friends-group-color);
      opacity: 0.78;
      transform: rotate(var(--friends-group-tilt));
      mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 80 8'><path d='M1 4.5 C 14 2 23 5.5 37 3.5 C 51 1.5 63 5.5 79 3' fill='none' stroke='black' stroke-width='5'/></svg>");
      -webkit-mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 80 8'><path d='M1 4.5 C 14 2 23 5.5 37 3.5 C 51 1.5 63 5.5 79 3' fill='none' stroke='black' stroke-width='5'/></svg>");
      mask-repeat: no-repeat;
      -webkit-mask-repeat: no-repeat;
      mask-size: 100% 100%;
      -webkit-mask-size: 100% 100%;
    }

    .friend-group__tab {
      display: inline-flex;
      flex: 0 0 auto;
      align-items: center;
      gap: 0.45rem;
      min-height: 2rem;
      padding: 0.35rem 0.75rem 0.35rem 0.6rem;
      border: 1px solid
        color-mix(
          in srgb,
          var(--friends-group-color) 68%,
          var(--friends-card-border)
        );
      border-radius: 3px 10px 4px 9px;
      background: color-mix(
        in srgb,
        var(--friends-group-color) 72%,
        var(--friends-card-bg)
      );
      box-shadow: 2px 3px 0 rgba(82, 64, 38, 0.09);
      color: var(--friends-ink);
      font-family: "Noto Sans Mono", monospace;
      font-size: 0.58rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      line-height: 1;
      transform: rotate(var(--friends-group-tilt));
    }

    html.dark .friend-group__tab {
      box-shadow: 2px 3px 0 rgba(0, 0, 0, 0.2);
    }

    .friend-group__tab-mark {
      width: 0.45rem;
      height: 0.45rem;
      border-radius: 50%;
      background: currentColor;
      opacity: 0.7;
    }

    .friend-group__heading {
      min-width: 0;
      flex: 1;
    }

    .friend-group__eyebrow {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.5rem 0.75rem;
      color: var(--friends-muted);
      font-family: "Noto Sans Mono", monospace;
      font-size: 0.62rem;
      letter-spacing: 0.08em;
      line-height: 1.4;
      text-transform: uppercase;
    }

    .friend-group__count {
      color: var(--friends-ink);
      font-weight: 700;
      letter-spacing: 0;
      text-transform: none;
    }

    .friend-group__heading h2 {
      position: relative;
      display: inline-block;
      margin: 0.15rem 0 0;
      color: var(--friends-ink);
      font-size: clamp(1.25rem, 2.3vw, 1.65rem);
      font-weight: 800;
      line-height: 1.35;
    }

    .friend-group__heading h2::first-letter {
      color: var(--friends-accent);
    }

    .friend-group__heading p {
      max-width: 42rem;
      margin: 0.25rem 0 0;
      color: var(--friends-muted);
      font-size: 0.8rem;
      line-height: 1.65;
    }

    .friends-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      align-items: stretch;
      gap: 20px;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .friend-card {
      --fcl-tilt: -0.25deg;
      --fcl-tape-color: var(--friends-tape-0);
      --fcl-tab-color: var(--friends-tab-0);
      position: relative;
      z-index: 1;
      border-radius: 10px;
      background: var(--friends-card-bg);
      box-shadow: var(--friends-card-shadow);
      isolation: isolate;
      transform: rotate(var(--fcl-tilt));
      transition:
        transform 0.22s ease,
        border-color 0.22s ease,
        box-shadow 0.22s ease;
    }

    .friend-card:nth-child(4n + 2) {
      --fcl-tilt: 0.22deg;
      --fcl-tape-color: var(--friends-tape-1);
      --fcl-tab-color: var(--friends-tab-1);
    }

    .friend-card:nth-child(4n + 3) {
      --fcl-tilt: -0.12deg;
      --fcl-tape-color: var(--friends-tape-2);
      --fcl-tab-color: var(--friends-tab-2);
    }

    .friend-card:nth-child(4n + 4) {
      --fcl-tilt: 0.3deg;
      --fcl-tape-color: var(--friends-tape-3);
      --fcl-tab-color: var(--friends-tab-3);
    }

    .friend-card:hover {
      z-index: 10;
    }

    .friend-card::before,
    .friend-card::after {
      content: "";
      position: absolute;
      pointer-events: none;
    }

    .friend-card::before {
      top: -8px;
      left: 22px;
      z-index: 5;
      width: 38px;
      height: 15px;
      background-color: var(--fcl-tape-color);
      background-image: repeating-linear-gradient(
        90deg,
        transparent,
        transparent 3px,
        rgba(255, 255, 255, 0.35) 3px,
        rgba(255, 255, 255, 0.35) 5px,
        transparent 5px,
        transparent 10px
      );
      box-shadow: 0 3px 8px rgba(82, 64, 38, 0.12);
      filter: saturate(0.92);
      transform: rotate(-3deg);
      border-radius: 2px;
    }

    html.dark .friend-card::before {
      box-shadow: 0 3px 8px rgba(0, 0, 0, 0.24);
    }

    .friend-card::after {
      top: 16px;
      right: -6px;
      z-index: -1;
      width: 6px;
      height: 48px;
      border: 1px dashed rgba(82, 64, 38, 0.12);
      border-left: 0;
      border-radius: 0 8px 8px 0;
      background: var(--fcl-tab-color);
      box-shadow: 2px 3px 0 rgba(82, 64, 38, 0.08);
      transition:
        width 0.25s cubic-bezier(0.34, 1.56, 0.64, 1),
        right 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    html.dark .friend-card::after {
      border-color: rgba(225, 230, 245, 0.1);
      box-shadow: 3px 4px 0 rgba(0, 0, 0, 0.16);
    }

    .friend-card:hover {
      transform: translateY(-3px) rotate(0deg);
    }

    .friend-card:hover::after {
      right: -12px;
      width: 12px;
    }

    .friend-shot {
      position: relative;
      height: 10rem;
      overflow: hidden;
      border-radius: 10px 10px 0 0;
      background: var(--friends-shot-fallback);
    }

    .friend-shot-image {
      height: 100%;
      width: 100%;
      object-fit: cover;
      transition: transform 0.45s ease;
    }

    .friend-card:hover .friend-shot-image {
      transform: scale(1.03);
    }

    .friend-shot-fallback {
      height: 100%;
      width: 100%;
      background: var(--friends-shot-fallback);
    }

    .friend-shot-mask {
      position: absolute;
      inset: 0;
      background: var(--friends-shot-mask);
    }

    .friend-latency {
      position: absolute;
      top: 0.8rem;
      right: 0.8rem;
      z-index: 3;
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      border-radius: 999px;
      border: 1px solid transparent;
      padding: 0.3rem 0.65rem;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      backdrop-filter: blur(10px);
    }

    .friend-latency-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: currentColor;
      flex-shrink: 0;
    }

    .friend-latency--fast,
    .friend-latency--ok {
      background: color-mix(in srgb, #86d993 28%, transparent);
      border-color: color-mix(in srgb, #86d993 50%, transparent);
      color: #166534;
    }

    html.dark .friend-latency--fast,
    html.dark .friend-latency--ok {
      background: #22c55e;
      border-color: #16a34a;
      color: #fff;
      backdrop-filter: none;
    }

    .friend-latency--slow {
      background: rgba(245, 158, 11, 0.14);
      border-color: rgba(245, 158, 11, 0.3);
      color: #b45309;
    }

    html.dark .friend-latency--slow {
      background: #f59e0b;
      border-color: #d97706;
      color: #fff;
      backdrop-filter: none;
    }

    .friend-latency--down {
      background: rgba(244, 63, 94, 0.14);
