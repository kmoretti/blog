---
import Layout from "../../layouts/Layout.astro";

const pageTitle = "友情链接 | 喵洛阁";
const pageDescription = "我的朋友们";
---

<Layout
  title={pageTitle}
  description={pageDescription}
  className="max-w-100px flex h-svh flex-col justify-center"
>
  <main class="space-y-6">
    <header class="mb-6 flex items-start justify-between gap-4">
      <div class="space-y-2">
        <nav aria-label="Breadcrumb" class="fp-breadcrumb">
          <a href="/">喵洛阁</a>
          <span class="mx-1">/</span>
        </nav>
        <h1 class="fp-heading text-2xl font-semibold">朋友们</h1>
      </div>
      <div class="flex shrink-0 gap-2">
        <a
          href="/friends/fcircle/"
          class="fp-link-btn inline-flex items-center rounded-full px-3 py-1.5 text-sm transition"
        >
          朋友圈
        </a>
        <a
          href="/friends/friends/"
          class="fp-link-btn inline-flex items-center rounded-full px-3 py-1.5 text-sm transition"
        >
          详细
        </a>
      </div>
    </header>
    <div
      id="friends-list"
      class="grid grid-cols-6 gap-3 p-4 sm:grid-cols-8 sm:gap-4 md:grid-cols-10 lg:grid-cols-10"
      aria-live="polite"
    >
      <p class="friends-status col-span-full text-center text-sm">
        正在加载友链…
      </p>
    </div>
    <div class="mt-6 flex justify-center gap-4">
      <a href="/friends/exchange/" class="fp-muted hover:underline">
        交换友链 &rarr;
      </a>
      <span class="fp-divider-text">|</span>
      <a href="/friends/fcircle/" class="fp-muted hover:underline">
        朋友圈 &rarr;
      </a>
    </div>
  </main>

  <style is:inline>
    .fp-breadcrumb {
      color: var(--fp-muted);
      font-size: 0.8125rem;
    }
    .fp-breadcrumb a {
      color: inherit;
      text-decoration: none;
    }
    .fp-breadcrumb a:hover {
      text-decoration: underline;
    }
    .fp-breadcrumb strong {
      color: var(--fp-ink);
      font-weight: 600;
    }
    .fp-heading {
      color: var(--fp-ink);
    }
    .fp-subtext {
      color: var(--fp-ink-soft);
    }
    .fp-muted,
    .friends-status {
      color: var(--fp-muted);
    }
    .fp-link-btn {
      border: 1px solid var(--fp-dash);
      background: var(--fp-paper);
      color: var(--fp-ink-soft);
    }
    .fp-link-btn:hover {
      border-color: var(--fp-accent);
      color: var(--fp-ink);
    }
    .fp-divider {
      border-color: var(--fp-dash);
    }
    .fp-divider-text {
      color: var(--fp-dash);
    }
    .fp-tag {
      border: 1px solid var(--fp-dash);
    }
  </style>

  <script>
    import { loadFriendGroups } from "../../lib/friends-client";

    const createFriend = (friend: {
      name: string;
      url: string;
      avatar: string;
    }) => {
      const link = document.createElement("a");
      link.href = friend.url;
      link.target = "_blank";
      link.rel = "noopener noreferrer";
      link.className =
        "group relative flex items-center justify-center transition-transform hover:z-10 hover:scale-110";
      link.title = friend.name;

      if (friend.avatar) {
        const image = document.createElement("img");
        image.src = friend.avatar;
        image.alt = friend.name;
        image.className = "w-12 rounded-full object-cover sm:w-14 md:w-16";
        image.loading = "lazy";
        image.addEventListener("error", () => image.remove(), { once: true });
        link.append(image);
      }

      const name = document.createElement("span");
      name.className =
        "pointer-events-none absolute bottom-[-2rem] left-1/2 z-50 -translate-x-1/2 whitespace-nowrap rounded px-2 py-1 text-sm opacity-0 transition-opacity group-hover:opacity-100";
      name.style.background = "var(--fp-ink)";
      name.style.color = "var(--fp-paper)";
      name.textContent = friend.name;
      link.append(name);

      return link;
    };

    const loadFriends = async () => {
      const friendsList = document.querySelector<HTMLElement>("#friends-list");
      if (!friendsList) return;

      friendsList.replaceChildren();

      try {
        const friends = (await loadFriendGroups()).flatMap(
          (group) => group.friends,
        );
        if (friends.length === 0) {
          throw new Error("No valid friends in remote data");
        }

        friendsList.append(...friends.map(createFriend));
      } catch (error) {
        console.warn("Failed to load friends:", error);
        const message = document.createElement("p");
        message.className = "friends-status col-span-full text-center text-sm";
        message.setAttribute("role", "alert");
        message.textContent = "友链数据暂时无法加载，请稍后刷新重试。";
        friendsList.append(message);
      }
    };

    document.addEventListener("astro:page-load", () => void loadFriends());
  </script>
</Layout>
